# services/middleware - copy to .env.local or export these directly.
# This service does not currently load a .env file automatically (dotenv is
# a listed dependency but unused) - config.ts reads process.env directly.
# This is the first .env.example for this service, so it documents the
# existing (previously undocumented) vars too, not just the new ones.

PORT=4000

# --- Quantum inference client (pipeline/quantumOrchestrationClient.ts) -
# calls services/quantum-pipeline's existing /infer endpoint. Unrelated to
# the new job-management vars below. ---
QUANTUM_ENGINE_URL=http://localhost:4002
QUANTUM_CLIENT_MODE=http
QUANTUM_TIMEOUT_MS=3000
QUANTUM_MAX_RETRIES=2
QUANTUM_FAILURE_RATE=0.05
QUBIT_BUDGET=8

# --- Decision engine thresholds ---
REVIEW_THRESHOLD=40
FRAUD_THRESHOLD=75
ENSEMBLE_QUANTUM_WEIGHT=0.75
ENSEMBLE_CLASSICAL_WEIGHT=0.25

# --- Blockchain gateway (integrations/blockchainClient.ts) ---
BLOCKCHAIN_GATEWAY_URL=http://localhost:4001
BLOCKCHAIN_WRITE_ENABLED=true

# --- Streaming ---
KAFKA_BROKERS=
STREAMING_RESPONSE_TIMEOUT_MS=15000

# --- Dashboard session auth (auth/dashboardAuth.ts) ---
DASHBOARD_JWT_SECRET=
DASHBOARD_TOKEN_TTL_SECONDS=28800
DASHBOARD_ADMIN_USERNAME=
DASHBOARD_ADMIN_PASSWORD=
DASHBOARD_NODE_USERNAME=
DASHBOARD_NODE_PASSWORD=

# --- Persistence ---
MIDDLEWARE_DB_PATH=

# --- New: IBM Quantum job-management API (routes/quantumJobsApi.ts,
# integrations/quantumJobsClient.ts). Calls services/quantum-pipeline's
# internal /quantum-jobs* endpoints - the IBM API key itself lives ONLY in
# that service's own env (see its .env.example), never here. ---
QUANTUM_JOBS_TIMEOUT_MS=10000
QUANTUM_JOBS_MAX_RETRIES=2
QUANTUM_JOBS_RATE_LIMIT_PER_MINUTE=10
QUANTUM_JOBS_MAX_CONCURRENT_PER_USER=5
