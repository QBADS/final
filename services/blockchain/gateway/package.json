{
  "name": "qbads-blockchain-gateway",
  "version": "1.0.0",
  "description": "The two documented gateway points into the QBADS Fabric network (input: REST/SDK/gRPC, output: receipts/queries/events) that Middleware connects through.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
