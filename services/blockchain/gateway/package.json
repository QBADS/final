    "@grpc/grpc-js": "^1.12.2",
    "@hyperledger/fabric-gateway": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
