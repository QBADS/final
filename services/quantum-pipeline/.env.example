# services/quantum-pipeline - copy to .env.local or export these directly.
# This service does not currently load a .env file automatically
# (python-dotenv is a listed dependency but unused) - these are documented
# for reference / a future dotenv wiring, and to run manually via `export`.

# --- Existing (unchanged) - see app/config.py ---
PORT=4002
FEATURE_DIMENSION=8
BACKEND_MODE=simulator
SHOTS=1024
FRAUD_THRESHOLD=0.5
BOOTSTRAP_SAMPLES=26
BOOTSTRAP_SEED=42
MODEL_VERSION=bootstrap-v0

# --- New: ad-hoc IBM Quantum job-management feature (exec-admin dashboard
# capability - submit/monitor/cancel a real IBM Quantum job, browse
# backends). Deliberately independent of BACKEND_MODE above, which keeps
# governing only the QSVM/QNN/VQC fraud models' local simulator execution,
# unchanged - see app/providers/base.py's module docstring for why. ---
QUANTUM_JOB_PROVIDER=mock
# mock      - fully deterministic canned data, no IBM account, no qiskit
#             execution. Default - the whole feature works out of the box.
# simulator - real local Qiskit execution (StatevectorSampler/Estimator),
#             still no IBM account, for exercising the job API with genuine
#             circuit results.
# ibm       - real IBM Quantum Compute Service REST API. Requires the two
#             variables below; fails closed at startup if either is unset.

# Required ONLY when QUANTUM_JOB_PROVIDER=ibm. NEVER commit real values here.
IBM_QUANTUM_API_KEY=
IBM_QUANTUM_CRN=

# Optional overrides (sane defaults shown) - only relevant when
# QUANTUM_JOB_PROVIDER=ibm.
IBM_QUANTUM_API_BASE_URL=https://quantum.cloud.ibm.com/api
IBM_QUANTUM_API_VERSION=2025-01-01
IBM_QUANTUM_IAM_URL=https://iam.cloud.ibm.com/identity/token
IBM_QUANTUM_TIMEOUT_SECONDS=30
IBM_QUANTUM_MAX_RETRIES=3
IBM_QUANTUM_TOKEN_REFRESH_MARGIN_SECONDS=300
